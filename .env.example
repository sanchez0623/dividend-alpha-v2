# dividend-alpha v3.0 · 环境变量样例（.env 不入库不入镜像）
# 数据源密钥
TUSHARE_TOKEN=
# 同花顺 fuyao（https://fuyao.aicubes.cn，请求头 X-api-key）
THS_API_KEY=sk-fuyao-xxxxxxxxxxxxxxxxxxxxxxxx

# 存储连接（生产用 PostgreSQL 16 + TimescaleDB；本地/测试可用 sqlite）
# 示例：postgresql+psycopg://da:da@localhost:5432/dividend_alpha
POSTGRES_DSN=sqlite:///./data/dividend_alpha.db
REDIS_URL=redis://localhost:6379/0

# 应用
DA_ENV=dev
DA_CONFIG_DIR=./config
DA_ARCHIVE_JSON=./web/data.json
DA_API_HOST=0.0.0.0
DA_API_PORT=8100
# ★ 接口命名空间前缀（前后端 + nginx 须一致），避免与同机其它服务 /api 冲突
DA_API_PREFIX=/da/v1

# 内部服务令牌（写操作仅限 paper 账本任务）
DA_SERVICE_TOKEN=change-me
